		Category = "Racing",
		MaxPlayers = 12,
		PlaceId = 0,
		InPlace = true,
		Creator = "VOIDZ Studios",
		Featured = true,
		SeedPopularity = 17400,
		Accent = { 0.2, 0.7, 1 },
		Accent2 = { 1, 0.8, 0.2 },
		Tagline = "Hold boost. Hit the apex.",
