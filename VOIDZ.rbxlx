Config.ReservedNames = {
	admin = true,
	administrator = true,
	mod = true,
	moderator = true,
	system = true,
	voidz = true,
	official = true,
	roblox = true,
	support = true,
	owner = true,
	staff = true,
	dev = true,
	developer = true,
