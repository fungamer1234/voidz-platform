          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Optional server-only assets (sounds, models) can be parented under
	ServerStorage.VOIDZ and cloned from here later. The platform runs
	without anything in this folder.
]]

return {}
]]></string>
