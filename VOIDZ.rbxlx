		Name = "Tower Clash",
		Description = "Two lanes, two cores. Spend income on units that march, and swing if you want the push yourself. First core to zero loses.",
		Category = "Strategy",
		MaxPlayers = 12,
		PlaceId = 0,
		InPlace = true,
