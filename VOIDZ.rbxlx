	"hair_short",
	"face_neutral",
	"shirt_core",
	"pants_core",
	"hat_none",
	"acc_none",
	"back_none",
	"fx_none",
}

Config.DefaultEquipped = {
	skin = "skin_void",
	hair = "hair_short",
	face = "face_neutral",
	shirt = "shirt_core",
	pants = "pants_core",
	hat = "hat_none",
	accessory = "acc_none",
